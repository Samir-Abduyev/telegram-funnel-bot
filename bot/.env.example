# Copy to .env and fill in. NEVER send this file to anyone and never commit it.

# Bot token from @BotFather (secret).
BOT_TOKEN=

# Your numeric Telegram id (ask @userinfobot). Only this account can use /set, /stats… and approve receipts.
OWNER_ID=

# Shown to people who choose «Kartla ödəniş» and in messages «write to me».
OWNER_CONTACT=@your_username

# Closed group for paid students, e.g. -1001234567890. Add the bot to the group as an admin
# with the right «Invite users via link»: the bot then sends you the group id itself.
GROUP_ID=

# Payment page (https://…). Empty = the «Ödəniş linki» button is hidden, only card payment remains.
PAYMENT_URL=

# Your channel (https://t.me/…). After lesson 1 the bot offers «📢 Kanala abunə ol» once — not required. Empty = no button.
CHANNEL_URL=

# Postgres (Supabase → Connect → Session pooler). Contains the password (secret).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# disable (local only) | require (default for remote hosts) | verify (+ DATABASE_CA_FILE from Supabase → Database → SSL)
DATABASE_SSL=require
DATABASE_CA_FILE=
